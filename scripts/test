#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

cd "$(dirname "$0")/.."

# Next to a Channel checkout, build against it: an untracked go.work stands in for a replace directive,
# which would break the module for everyone who gets it from GitHub.
if [[ ! -f go.work && -d ../../Channel/channel-go ]]; then
  go work init . ../../Channel/channel-go
  go work edit -go=1.25.0
fi

go vet ./...
go test ./...
